# Environment
.env
*.env

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
venv/
.venv/
*.egg-info/
dist/
build/

# Data (large files — never commit satellite tiles)
data/raw/
data/processed/*
*.tif
*.tiff
*.nc
*.h5
*.zip
*.SAFE/

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/index_history.parquet
!data/processed/wells_history.parquet
!data/processed/water_balance_params.json
!data/processed/water_balance_drivers.parquet
# Marker written by the GitHub Action on each scheduled pipeline run; the
# dashboard freshness card reads it. Allow it to be committed by the bot.
!data/processed/.last_pipeline_run.txt

# Notebooks checkpoints
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Dev tooling not for repo
cloudflared-linux-amd64.deb

# Stray Windows-path-named files (copy-paste artifacts)
C:\\Users\\*
