# Copy this file to .env and fill in your credentials
# Never commit .env to git

# Anthropic API key (for LLM Spanish alert generation)
# Get yours free at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_key_here

# Copernicus Data Space credentials (free registration at dataspace.copernicus.eu)
# Only needed if using the live satellite download pipeline
CDSE_USER=your_email@example.com
CDSE_PASSWORD=your_password

# Optional: Mapbox token for premium map tiles (leave blank to use OpenStreetMap — free)
MAPBOX_TOKEN=
